<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.hollowcrown</groupId>
    <artifactId>hollowcrown-platform</artifactId>
    <version>1.21.4-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <version>1.21.4-a0.1.17</version>
  <artifactId>hollowcrown-hub</artifactId>
  <packaging>jar</packaging>
  <name>HC-Hub</name>
  <description>Hollow Crown Hub — templates, lobbies, parties, /hch.</description>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hollowcrown</groupId>
      <artifactId>hollowcrown-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
      <dependency>
          <groupId>net.hydraulicicecube</groupId>
          <artifactId>fake-team-api</artifactId>
          <version>1.21.4</version>
          <scope>system</scope>
          <systemPath>${project.basedir}/../lib/FakeTeamAPI-1.21.4-1.0.0.jar</systemPath>
      </dependency>
  </dependencies>

  <build>
    <finalName>HollowCrownHub-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>plugin.yml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>com.google.gson</pattern>
                  <shadedPattern>com.hollowcrown.hub.shaded.gson</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.zaxxer.hikari</pattern>
                  <shadedPattern>com.hollowcrown.hub.shaded.hikari</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.mysql.cj</pattern>
                  <shadedPattern>com.hollowcrown.hub.shaded.mysql</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
